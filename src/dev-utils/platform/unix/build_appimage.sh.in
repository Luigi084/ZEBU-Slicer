#!/usr/bin/env bash
# ZEBU Slicer AppImage packaging (run from the "package_appimage" directory by build_linux_image.sh).
set -euo pipefail
APPIMAGETOOLURL="https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-$(uname -m).AppImage"
REPO_ROOT="@CMAKE_SOURCE_DIR@"

APP_ID="com.zebu.ZEBUSlicer"
APP_IMAGE="ZEBU_Slicer_Linux_V@ZEBU_VERSION@.AppImage"

if [ ! -x ../appimagetool.AppImage ]; then
    wget ${APPIMAGETOOLURL} -O ../appimagetool.AppImage
    chmod +x ../appimagetool.AppImage
fi

if [ -f /.dockerenv ] ; then # Only run if inside of a Docker Container
sed '0,/AI\x02/{s|AI\x02|\x00\x00\x00|}' -i  ../appimagetool.AppImage
fi

mv @SLIC3R_APP_CMD@ AppRun
chmod +x AppRun

# The upstream icon file names are kept; their content is the ZEBU logo.
cp resources/images/OrcaSlicer_192px.png ${APP_ID}.png
mkdir -p usr/share/icons/hicolor/192x192/apps
cp resources/images/OrcaSlicer_192px.png usr/share/icons/hicolor/192x192/apps/${APP_ID}.png
cat <<DESKTOP > ${APP_ID}.desktop
[Desktop Entry]
Name=ZEBU Slicer
GenericName=3D Printing Software
Exec=AppRun %F
Icon=${APP_ID}
Type=Application
Terminal=false
Categories=Graphics;3DGraphics;Engineering;
MimeType=model/stl;model/3mf;application/vnd.ms-3mfdocument;application/prs.wavefront-obj;application/x-amf;model/step;
StartupWMClass=@SLIC3R_APP_CMD@
DESKTOP

mkdir -p usr/share/applications
cp ${APP_ID}.desktop usr/share/applications/

mkdir -p usr/share/metainfo
cp "${REPO_ROOT}/scripts/flatpak/${APP_ID}.metainfo.xml" "usr/share/metainfo/${APP_ID}.metainfo.xml"
cp "${REPO_ROOT}/scripts/flatpak/${APP_ID}.metainfo.xml" "usr/share/metainfo/${APP_ID}.appdata.xml"

export ARCH=$(uname -m)
# appimagetool is itself an AppImage: run it in extract mode so it works without FUSE
# (GitHub's Ubuntu 24.04 runners and most containers have no libfuse2).
# AppStream metadata: validated here offline (an online check would make the build depend on the network),
# then appimagetool is told not to validate it again.
if command -v appstreamcli > /dev/null; then
    appstreamcli validate --no-net "usr/share/metainfo/${APP_ID}.metainfo.xml"
fi
../appimagetool.AppImage --appimage-extract-and-run --no-appstream . "${APP_IMAGE}"
chmod +x "${APP_IMAGE}"
