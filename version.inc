# Included by CMakeLists, edited by the build script
# (the version numbers are generated by the build script from the git current label)

set(SLIC3R_APP_NAME "ZEBU Slicer")
set(SLIC3R_APP_KEY "ZEBUSlicer")

if(NOT DEFINED BBL_INTERNAL_TESTING)
set(BBL_INTERNAL_TESTING "0")
endif()
# ZEBU: SoftFever_VERSION stays the upstream Orca base version. It is written into and compared
# against 3MF/project files, so keeping it lets ZEBU open Orca projects without "newer version" errors.
set(SoftFever_VERSION "2.5.2")
# ZEBU Slicer's own version: shown to the user, used by the installer and the updater.
set(ZEBU_VERSION "0.1.0-beta")
string(REGEX MATCH "^([0-9]+)\\.([0-9]+)\\.([0-9]+)" ZEBU_VERSION_MATCH ${ZEBU_VERSION})
set(ZEBU_VERSION_MAJOR ${CMAKE_MATCH_1})
set(ZEBU_VERSION_MINOR ${CMAKE_MATCH_2})
set(ZEBU_VERSION_PATCH ${CMAKE_MATCH_3})
# Executable name (Linux binary, Windows exe) and the GitHub repository used by the updater.
set(ZEBU_APP_CMD "zebu-slicer")
if (NOT DEFINED ZEBU_UPDATE_REPO)
    set(ZEBU_UPDATE_REPO "CHANGE_ME/ZEBU-Slicer" CACHE STRING "owner/repo whose GitHub Releases the updater checks")
endif()
string(REGEX MATCH "^([0-9]+)\\.([0-9]+)\\.([0-9]+)"
       SoftFever_VERSION_MATCH ${SoftFever_VERSION})
set(ORCA_VERSION_MAJOR ${CMAKE_MATCH_1})
set(ORCA_VERSION_MINOR ${CMAKE_MATCH_2})
set(ORCA_VERSION_PATCH ${CMAKE_MATCH_3})

set(SLIC3R_VERSION "02.08.01.55")

if (NOT DEFINED ORCA_UPDATER_SIG_KEY)
    set(ORCA_UPDATER_SIG_KEY "" CACHE STRING "Base64url encoded updater signature key")
endif()
